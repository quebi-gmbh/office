# Google Drive workspace — client-side config. Copy to .env.local and fill in.
# All VITE_* values ship in the browser bundle; secure them with authorized
# JavaScript origins (OAuth client) and website/API restrictions (API key),
# NOT by keeping them secret. Never add the OAuth client_secret here.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PROJECT_NUMBER=
VITE_GOOGLE_API_KEY=
